generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ────────────────────────────────────────────────────────────────────

model User {
  id                   String            @id @default(uuid())
  name                 String
  email                String            @unique
  passwordHash         String            @map("password_hash")
  role                 UserRole          @default(child)
  createdAt            DateTime          @default(now()) @map("created_at")
  resetToken           String?           @map("reset_token")
  resetTokenExpiry     DateTime?         @map("reset_token_expiry")
  devices              Device[]
  fcmTokens            FcmToken[]
  subscription         UserSubscription?
  subscriptionRequest  SubscriptionRequest?
  payments             Payment[]
  consentLogs          ConsentLog[]

  @@map("users")
}

// ── Subscription plans (created/managed by admin) ─────────────────────────────

model SubscriptionPlan {
  id           String             @id @default(cuid())
  name         String             @unique
  description  String?
  price        Float              @default(0)   // monthly price, 0 = free
  durationDays Int                @default(30)  @map("duration_days")
  features     String             // JSON: SubscriptionFeatures
  isActive     Boolean            @default(true) @map("is_active")
  sortOrder    Int                @default(0)   @map("sort_order")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt    @map("updated_at")
  subscriptions UserSubscription[]
  requests      SubscriptionRequest[]
  payments      Payment[]

  @@map("subscription_plans")
}

model UserSubscription {
  id         String           @id @default(cuid())
  userId     String           @unique @map("user_id")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId     String           @map("plan_id")
  plan       SubscriptionPlan @relation(fields: [planId], references: [id])
  status     String           @default("active")  // active | expired | cancelled
  startedAt  DateTime         @default(now()) @map("started_at")
  expiresAt  DateTime?        @map("expires_at")  // null = no expiry
  assignedBy String?          @map("assigned_by")  // admin user id
  notes      String?
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([planId])
  @@map("user_subscriptions")
}

// ── Consent records (DPDP Act 2023 / GDPR compliance) ────────────────────────
model ConsentLog {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentVersion String   @default("1.0") @map("consent_version")
  items          String   // JSON array of consent item IDs confirmed
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  purpose        String   @default("app_download") // app_download | data_processing
  grantedAt      DateTime @default(now()) @map("granted_at")
  revokedAt      DateTime? @map("revoked_at")

  @@index([userId])
  @@map("consent_logs")
}

model Payment {
  id                  String           @id @default(cuid())
  userId              String           @map("user_id")
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId              String           @map("plan_id")
  plan                SubscriptionPlan @relation(fields: [planId], references: [id])
  razorpayOrderId     String?          @unique @map("razorpay_order_id")
  razorpayPaymentId   String?          @map("razorpay_payment_id")
  razorpayPaymentLinkId String?        @map("razorpay_payment_link_id")
  amount              Float
  currency            String           @default("INR")
  status              String           @default("created")  // created | paid | failed
  type                String           @default("checkout") // checkout | payment_link
  createdAt           DateTime         @default(now()) @map("created_at")

  @@index([userId])
  @@map("payments")
}

model SubscriptionRequest {
  id        String           @id @default(cuid())
  userId    String           @unique @map("user_id")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String           @map("plan_id")
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  message   String?
  status    String           @default("pending")  // pending | approved | rejected
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([planId])
  @@map("subscription_requests")
}

model FcmToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("fcm_tokens")
}

enum UserRole {
  parent
  child
  admin
}

// ── Devices ──────────────────────────────────────────────────────────────────

model Device {
  id           String     @id @default(uuid())
  deviceId     String     @unique @map("device_id")
  name         String
  userId       String     @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         DeviceRole
  isOnline     Boolean    @default(false) @map("is_online")
  lastSeen     DateTime?  @map("last_seen")
  ipAddress    String?    @map("ip_address")
  registeredAt DateTime   @default(now()) @map("registered_at")

  locationLogs     LocationLog[]
  appUsageLogs     AppUsageLog[]
  notificationLogs NotificationLog[]
  statusLogs       DeviceStatusLog[]
  callLogs         CallLog[]
  smsLogs          SmsLog[]
  contacts         Contact[]
  galleryItems     GalleryItem[]
  browsingHistory  BrowsingHistory[]
  remoteCommands   RemoteCommand[]
  geofences        Geofence[]
  appBlockRules    AppBlockRule[]

  @@map("devices")
}

enum DeviceRole {
  child
  parent
}

// ── Location logs ─────────────────────────────────────────────────────────────

model LocationLog {
  id           String   @id
  deviceId     String   @map("device_id")
  device       Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  latitude     Float
  longitude    Float
  accuracy     Float?
  altitude     Float?
  speed        Float?
  heading      Float?
  provider     String?
  address      String?
  activityType String?  @map("activity_type") // still | walking | running | on_bicycle | in_vehicle
  isMoving     Boolean? @map("is_moving")
  capturedAt   DateTime @map("captured_at")
  syncedAt     DateTime @default(now()) @map("synced_at")

  @@index([deviceId, capturedAt(sort: Desc)])
  @@map("location_logs")
}

// ── App usage logs ────────────────────────────────────────────────────────────

model AppUsageLog {
  id              String   @id
  deviceId        String   @map("device_id")
  device          Device   @relation(fields: [deviceId], references: [deviceId])
  packageName     String   @map("package_name")
  appName         String   @map("app_name")
  usageDurationMs BigInt   @map("usage_duration_ms")
  launchCount     Int      @default(0) @map("launch_count")
  lastUsed        DateTime @map("last_used")
  capturedAt      DateTime @map("captured_at")
  category        String?
  syncedAt        DateTime @default(now()) @map("synced_at")

  @@index([deviceId, capturedAt(sort: Desc)])
  @@map("app_usage_logs")
}

// ── Notification logs ─────────────────────────────────────────────────────────

model NotificationLog {
  id          String   @id
  deviceId    String   @map("device_id")
  device      Device   @relation(fields: [deviceId], references: [deviceId])
  packageName String   @map("package_name")
  appName     String   @map("app_name")
  title       String?
  body        String?
  bigText     String?  @map("big_text")
  postedAt    DateTime @map("posted_at")
  category    String?
  isRead      Boolean  @default(false) @map("is_read")
  syncedAt    DateTime @default(now()) @map("synced_at")

  @@index([deviceId, postedAt(sort: Desc)])
  @@map("notification_logs")
}

// ── Device status logs ────────────────────────────────────────────────────────

model DeviceStatusLog {
  id             String   @id
  deviceId       String   @map("device_id")
  device         Device   @relation(fields: [deviceId], references: [deviceId])
  batteryLevel   Int      @map("battery_level")
  isCharging     Boolean  @map("is_charging")
  networkType    String   @map("network_type")
  isConnected    Boolean  @map("is_connected")
  wifiSsid       String?  @map("wifi_ssid")
  signalStrength Int?     @map("signal_strength")
  capturedAt     DateTime @map("captured_at")
  syncedAt       DateTime @default(now()) @map("synced_at")

  @@index([deviceId, capturedAt(sort: Desc)])
  @@map("device_status_logs")
}

// ── Call logs ─────────────────────────────────────────────────────────────────

model CallLog {
  id        String   @id
  deviceId  String   @map("device_id")
  device    Device   @relation(fields: [deviceId], references: [deviceId])
  number    String
  name      String?
  type      String   // incoming | outgoing | missed | rejected
  duration  Int      // seconds
  simSlot   Int?     @map("sim_slot") // 0 = SIM1, 1 = SIM2
  timestamp DateTime
  syncedAt  DateTime @default(now()) @map("synced_at")

  @@index([deviceId, timestamp(sort: Desc)])
  @@map("call_logs")
}

// ── SMS logs ──────────────────────────────────────────────────────────────────

model SmsLog {
  id        String   @id
  deviceId  String   @map("device_id")
  device    Device   @relation(fields: [deviceId], references: [deviceId])
  address   String                    // phone number or contact name
  body      String
  type      Int                       // 1=inbox 2=sent 3=draft 4=outbox
  date      DateTime
  isRead    Boolean  @default(false) @map("is_read")
  threadId  String?  @map("thread_id")
  subject   String?
  syncedAt  DateTime @default(now()) @map("synced_at")

  @@index([deviceId, date(sort: Desc)])
  @@map("sms_logs")
}

// ── Contacts ──────────────────────────────────────────────────────────────────

model Contact {
  id       String   @id
  deviceId String   @map("device_id")
  device   Device   @relation(fields: [deviceId], references: [deviceId])
  name     String
  phones   String   // JSON array of phone numbers
  emails   String   @default("[]") // JSON array
  groups   String   @default("[]") // JSON array of group names
  notes    String?
  syncedAt DateTime @default(now()) @map("synced_at")

  @@index([deviceId])
  @@map("contacts")
}

// ── Gallery items (metadata only) ─────────────────────────────────────────────

model GalleryItem {
  id        String    @id
  deviceId  String    @map("device_id")
  device    Device    @relation(fields: [deviceId], references: [deviceId])
  fileName  String    @map("file_name")
  mimeType  String    @map("mime_type") // image/* | video/*
  sizeBytes BigInt    @map("size_bytes")
  width     Int?
  height    Int?
  duration  Int?      // video duration in seconds
  takenAt   DateTime? @map("taken_at")
  localPath String?   @map("local_path") // path on device storage
  album     String?   // album/folder name
  thumbnail String?   // base64-encoded JPEG thumbnail (~200x200) for grid
  imageUrl  String?   @map("image_url") // served URL to full-size image on disk
  syncedAt  DateTime  @default(now()) @map("synced_at")

  @@index([deviceId, takenAt(sort: Desc)])
  @@map("gallery_items")
}

// ── Browsing history ──────────────────────────────────────────────────────────

model BrowsingHistory {
  id         String   @id
  deviceId   String   @map("device_id")
  device     Device   @relation(fields: [deviceId], references: [deviceId])
  url        String
  title      String?
  visitedAt  DateTime @map("visited_at")
  browserApp String?  @map("browser_app") // package name of browser
  visitCount Int      @default(1) @map("visit_count")
  syncedAt   DateTime @default(now()) @map("synced_at")

  @@index([deviceId, visitedAt(sort: Desc)])
  @@map("browsing_history")
}

// ── Remote commands (admin → device command queue) ────────────────────────────

model RemoteCommand {
  id          String    @id @default(uuid())
  deviceId    String    @map("device_id")
  device      Device    @relation(fields: [deviceId], references: [deviceId])
  commandType String    @map("command_type")
  // capture_photo | start_mic | stop_mic | start_recording | stop_recording
  // get_screen | list_files | block_app | unblock_app | lock_device
  payload     String    @default("{}") // JSON — e.g. { "camera": "front" }
  status      String    @default("pending")
  // pending | delivered | executing | completed | failed | cancelled
  result      String?   // JSON result from device (e.g. base64 photo, file list)
  issuedAt    DateTime  @default(now()) @map("issued_at")
  deliveredAt DateTime? @map("delivered_at")
  completedAt DateTime? @map("completed_at")

  @@index([deviceId, issuedAt(sort: Desc)])
  @@index([deviceId, status])
  @@map("remote_commands")
}

// ── Geofences ─────────────────────────────────────────────────────────────────

model Geofence {
  id        String   @id @default(uuid())
  deviceId  String   @map("device_id")
  device    Device   @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)
  name      String
  latitude  Float
  longitude Float
  radiusM   Int      @map("radius_m") // radius in metres
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  alerts    GeofenceAlert[]

  @@index([deviceId])
  @@map("geofences")
}

// ── Geofence alerts (device crossed a zone) ───────────────────────────────────

model GeofenceAlert {
  id          String   @id @default(uuid())
  geofenceId  String   @map("geofence_id")
  geofence    Geofence @relation(fields: [geofenceId], references: [id], onDelete: Cascade)
  deviceId    String   @map("device_id")
  alertType   String   @map("alert_type") // enter | exit
  latitude    Float
  longitude   Float
  triggeredAt DateTime @map("triggered_at")
  syncedAt    DateTime @default(now()) @map("synced_at")

  @@index([geofenceId, triggeredAt(sort: Desc)])
  @@index([deviceId, triggeredAt(sort: Desc)])
  @@map("geofence_alerts")
}

// ── Contact inquiries (from landing page) ────────────────────────────────────

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("new")  // new | read | replied
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@map("inquiries")
}

// ── App block rules ───────────────────────────────────────────────────────────

model AppBlockRule {
  id          String   @id @default(uuid())
  deviceId    String   @map("device_id")
  device      Device   @relation(fields: [deviceId], references: [deviceId])
  packageName String   @map("package_name")
  appName     String   @map("app_name")
  isBlocked   Boolean  @default(true) @map("is_blocked")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([deviceId, packageName])
  @@index([deviceId])
  @@map("app_block_rules")
}
