# Copy this to config.env and fill in. config.env is gitignored — it ends up
# holding an instance name and hostnames, nothing secret by itself, but keep
# it out of version control anyway.
#
# TEMPLATE ONLY — no AWS account/region/instance has been provisioned for
# ParentGuard yet. Every value below is a placeholder; review each one
# before running 02/03. Requires: AWS CLI v2 configured (`aws configure`)
# with an IAM user/role that can create EC2 instances, security groups, and
# Elastic IPs. A free-tier account is enough.
#
# Note: this repo's own README calls backend/ and admin_web/ "placeholder,
# not implemented" — mobile_app/ (Flutter) is the primary product. This
# template still stands up backend+admin_web for testing, per your own
# call; there's no S3/file-upload step here because neither app has an
# object-storage feature yet (no multer/aws-sdk dependency).

# ── AWS ──────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1

# ── EC2 (set by 02-launch-ec2.sh, read by 03-deploy-app.sh) ────────────────
INSTANCE_NAME=parentguard-test
# t3.micro — free-tier eligible (750 hrs/month, 12 months on a new account).
# Anything bigger bills against your card immediately.
INSTANCE_TYPE=t3.micro
KEY_NAME=parentguard-test-key
SECURITY_GROUP_NAME=parentguard-test-sg
# Leave blank to auto-detect your current public IP for SSH access.
SSH_CIDR=

# ── Custom domain (optional — 04-setup-domain.sh) ───────────────────────
# Leave both blank to keep using the sslip.io address from 02-launch-ec2.sh.
# Fill in once you've pointed real DNS A records at your Elastic IP.
BACKEND_HOSTNAME=
ADMIN_HOSTNAME=

# ── Database (native Postgres on the EC2 instance — this app doesn't
# containerize Postgres even in local dev, so the test box matches that) ──
DB_NAME=parental_monitor
DB_USER=parentguard_app
# Leave blank to auto-generate a random password on first deploy (written to
# credentials.txt, reused on every re-deploy after that).
DB_PASSWORD=
