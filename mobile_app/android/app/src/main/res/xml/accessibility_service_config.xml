<?xml version="1.0" encoding="utf-8"?>
<!--
    typeWindowStateChanged  — app switch + new browser window/tab
    typeViewTextChanged     — URL bar text update after navigation
                              (works WITHOUT canRetrieveWindowContent)

    canRetrieveWindowContent = true  — enables rootInActiveWindow tree traversal
                                       (Layer B: polling + tree scan)
                                       Requires re-toggle after first install.

    flagReportViewIds       — enables findAccessibilityNodeInfosByViewId
    flagRetrieveInteractiveWindows — enables getWindows() fallback
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="50"
    android:packageNames=""
    android:settingsActivity=".MainActivity" />
