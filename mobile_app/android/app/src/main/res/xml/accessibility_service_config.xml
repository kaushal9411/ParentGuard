<?xml version="1.0" encoding="utf-8"?>
<!--
    Accessibility config for ParentGuard.

    canRetrieveWindowContent = true   — needed to read browser address-bar text
                                        for URL history capture.
    accessibilityEventTypes            — typeWindowStateChanged fires on every
                                        page navigation (app switch or new page),
                                        which is when we read the URL bar.
    flagReportViewIds                  — allows findAccessibilityNodeInfosByViewId
                                        to locate the URL bar by its resource ID.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="100"
    android:packageNames=""
    android:settingsActivity=".MainActivity" />
